  "components": {
    "schemas": {
      "BalanceRead": {
        "properties": {
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "upcoming_bills": {
            "items": {
              "$ref": "#/components/schemas/UpcomingBill"
            },
            "type": "array",
            "title": "Upcoming Bills"
          },
          "upcoming_bills_total": {
            "type": "number",
            "title": "Upcoming Bills Total"
          },
          "safe_to_spend": {
            "type": "number",
            "title": "Safe To Spend"
          }
        },
        "type": "object",
        "required": [
          "balance",
          "upcoming_bills",
          "upcoming_bills_total",
          "safe_to_spend"
        ],
        "title": "BalanceRead"
      },
      "BankConnection": {
        "properties": {
          "nessie_customer_id": {
            "type": "string",
            "title": "Nessie Customer Id"
          }
        },
        "type": "object",
        "required": [
          "nessie_customer_id"
        ],
        "title": "BankConnection"
      },
      "BearerResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type"
        ],
        "title": "BearerResponse"
      },
      "Body_auth-reset_forgot_password": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "Body_auth-reset:forgot_password"
      },
      "Body_auth-reset_reset_password": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "Body_auth-reset:reset_password"
      },
      "Body_auth-verify_request-token": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "Body_auth-verify:request-token"
      },
      "Body_auth-verify_verify": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Body_auth-verify:verify"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "equa"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
