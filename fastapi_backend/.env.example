# Copy to .env and fill in. Never commit .env.

# --- Web API ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mydatabase
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/testdatabase
ACCESS_SECRET_KEY=change-me
RESET_PASSWORD_SECRET_KEY=change-me
VERIFICATION_SECRET_KEY=change-me
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["*"]
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@test.com
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# Capital One Nessie (mock banking)
NESSIE_API_KEY=your-nessie-key

# Google Gemini (Equa chat and program extraction)
GEMINI_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash

# --- Program discovery pipeline (docs/program-discovery-pipeline.md, Section 13) ---
# Only the worker and the commands/ scripts read these; the web API boots without them.
SERPAPI_API_KEY=your-serpapi-key
# Our own cap per billing period. Keep it below the plan's limit (Free Plan: 250/month).
SERPAPI_MONTHLY_BUDGET=200
SERPAPI_RESERVE=50
SERPAPI_MAX_SEARCHES_STATE_JOB=20
SERPAPI_MAX_SEARCHES_CITY_JOB=12

# Optional until you have one: load_zip_data falls back to the Census ZCTA-county file.
HUD_API_TOKEN=your-hud-user-token

EXTRACTION_MODEL=gemini-3.5-flash
EXTRACTION_MAX_CHARS=60000
AUTO_PUBLISH_CONFIDENCE=0.80
MAX_PAGES_PER_JOB=40
WORKER_CONCURRENCY=2
FETCH_USER_AGENT=EquaBot/1.0 (+https://example.com/bot)
ENABLE_COUNTY_DISCOVERY=false
BOOTSTRAP_CITIES_TOP_N=0

# Set to 1 only when running commands.smoke_live by hand.
ALLOW_LIVE_SMOKE=0

# --- Snowflake reporting copy (Section 16; see snowflake/README.md) ---------------
# Off by default. One-way Postgres -> Snowflake; nothing in the app reads it.
SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=PROGRAM_PIPELINE_SVC
# Key-pair auth only (TYPE = SERVICE user, no password). Keep the key out of the repo.
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=PROGRAM_PIPELINE_LOADER
SNOWFLAKE_WAREHOUSE=PROGRAM_PIPELINE_WH
SNOWFLAKE_DATABASE=PROGRAM_PIPELINE
SNOWFLAKE_SYNC_INTERVAL_MINUTES=60
